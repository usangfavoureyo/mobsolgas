# Supabase project URL and public publishable/anon key (safe for client use).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key. Never prefix with NEXT_PUBLIC_ or expose to browser/mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack keys are server-only. Never use NEXT_PUBLIC_ for either secret.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me

# Public base URL used for Paystack's verified payment return.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (the public key is safe for the browser; keep the private key server-only)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
